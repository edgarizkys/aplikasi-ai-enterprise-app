// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users      User[]
  items      Item[]
  analytics  Analytics[]

  @@index([deletedAt])
  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  email     String
  username  String
  password  String
  fullName  String?
  role      UserRole @default(USER)
  
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, createdAt])
  @@index([deletedAt])
  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

// ============================================================================
// BUSINESS ENTITIES
// ============================================================================

model Item {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  status      ItemStatus @default(ACTIVE)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("items")
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================================================
// ANALYTICS & AUDIT
// ============================================================================

model Analytics {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  eventType String
  eventData String?
  
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, eventType])
  @@map("analytics")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  
  action    String
  entity    String
  entityId  String
  changes   String?
  userId    String?
  
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}