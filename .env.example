# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aplikasi_ai_enterprise"

# JWT
JWT_ACCESS_SECRET="your_access_token_secret_key_min_32_chars"
JWT_REFRESH_SECRET="your_refresh_token_secret_key_min_32_chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
NODE_ENV="development"
PORT=3000
API_BASE_URL="http://localhost:3000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Aplikasi Ai Enterprise"

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"

# Storage (optional)
STORAGE_TYPE="local"
STORAGE_PATH="./uploads"

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"

# CORS
CORS_ORIGIN="http://localhost:3001"

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Features
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=false
ENABLE_EXPORT=true